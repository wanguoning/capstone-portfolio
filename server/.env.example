# Copy this file to .env and fill in your own local values
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/capstone_db
JWT_SECRET=replace_this_with_a_long_random_secret_string
CORS_ORIGIN=http://localhost:5173

# Optional: MongoDB Atlas connection string for cloud deployment
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/capstone_db
